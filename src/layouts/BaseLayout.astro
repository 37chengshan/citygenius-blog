---
import { assetUrl, withBase } from '../lib/url';
import PixelCat from '../components/PixelCat.astro';
import { ui, localePath, stripLocale, type Lang } from '../i18n';
import { getPosts } from '../lib/posts';

interface Props {
  title: string;
  description: string;
  extraFonts?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  lang?: Lang;
}
const {
  title,
  description,
  extraFonts = '',
  image = 'hero.webp',
  imageAlt = 'CityGenius Blog',
  type = 'website',
  lang = 'zh',
} = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'zh' ? 'en' : 'zh';
const barePath = stripLocale(Astro.url.pathname);
const altHref = localePath(other, barePath);
const zhHref = new URL(localePath('zh', barePath), Astro.site ?? 'https://37chengshan.github.io');
const enHref = new URL(localePath('en', barePath), Astro.site ?? 'https://37chengshan.github.io');
const L = (p: string) => localePath(lang, p);

const site = Astro.site ?? new URL('https://37chengshan.github.io');
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(assetUrl(image), site);
const siteUrl = new URL(withBase('/'), site).href.replace(/\/$/, '');
const _bd = new Date();
const issueDate = _bd.getFullYear() + '.' + String(_bd.getMonth() + 1).padStart(2, '0');
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'CityGenius Blog',
  url: siteUrl,
  description,
  inLanguage: t.htmlLang,
  author: { '@type': 'Person', name: 'CityGenius', url: 'https://github.com/37chengshan' },
};
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'CityGenius',
  url: siteUrl,
  sameAs: ['https://github.com/37chengshan'],
  knowsAbout: ['Vibe Coding', 'AI Agents', 'FastAPI', 'React', 'Android', 'Swift', '全栈开发'],
};
const palPosts = (await getPosts(lang))
  .filter((p) => p.id !== 'dev-log')
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .map((p) => ({ t: p.data.title.replace(/<[^>]+>/g, ''), d: p.data.date, c: p.data.category, h: L(`/article/${p.id}/`), k: `${p.data.tags.join(' ')} ${p.data.description}` }));
const ux = t.ux;
const palData = {
  posts: palPosts,
  go: [
    { t: t.footHome, h: L('/#top'), k: 'home 首页' },
    { t: t.nav.about, h: L('/#about'), k: 'about 关于' },
    { t: t.nav.projects, h: L('/#projects'), k: 'projects 项目' },
    { t: t.nav.articles, h: L('/article/'), k: 'articles 文章' },
    { t: t.nav.news, h: L('/news/'), k: 'news 新闻' },
    { t: t.nav.contact, h: L('/#contact'), k: 'contact 联系' },
  ],
  do: [
    { t: ux.theme, a: 'theme', k: 'theme dark light 深色 浅色 主题' },
    { t: ux.toggleLang, h: altHref, k: 'language 语言 english 中文' },
    { t: ux.copyPage, a: 'copy', k: 'copy link 复制 链接' },
    { t: ux.top, a: 'top', k: 'top 顶部' },
  ],
  str: { posts: ux.palPosts, go: ux.palGo, do: ux.palDo, empty: ux.palEmpty, copied: ux.linkCopied, toLight: ux.toLight, toDark: ux.toDark, away: ux.away, konami: ux.konami, meow: ux.meow, poke: ux.poke },
};
---
<!DOCTYPE html>
<html lang={t.htmlLang} data-lang={lang}>
<head>
<meta charset='utf-8' />
<meta name='viewport' content='width=device-width, initial-scale=1' />
<title>{title}</title>
<meta name='description' content={description} />
<meta name='author' content='CityGenius' />
<meta name='theme-color' content='#faf9f5' media='(prefers-color-scheme: light)' />
<meta name='theme-color' content='#262624' media='(prefers-color-scheme: dark)' />
<script is:inline>
  (function () {
    try {
      var s = localStorage.getItem('cg-scheme');
      if (s !== 'dark' && s !== 'light') s = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.dataset.scheme = s;
    } catch (e) {}
  })();
</script>
<meta name='generator' content={Astro.generator} />
<link rel='canonical' href={canonical} />
<link rel='icon' href={withBase('/assets/hero.webp')} type='image/webp' />
<link rel='alternate' type='application/rss+xml' title='CityGenius Blog RSS' href={withBase(lang === 'en' ? '/en/rss.xml' : '/rss.xml')} />
<meta property='og:site_name' content='CityGenius Blog' />
<meta property='og:locale' content={t.ogLocale} />
<link rel='alternate' hreflang='zh-CN' href={zhHref} />
<link rel='alternate' hreflang='en' href={enHref} />
<link rel='alternate' hreflang='x-default' href={zhHref} />
<meta property='og:type' content={type} />
<meta property='og:title' content={title} />
<meta property='og:description' content={description} />
<meta property='og:url' content={canonical} />
<meta property='og:image' content={ogImage} />
<meta property='og:image:alt' content={imageAlt} />
<meta name='twitter:card' content='summary_large_image' />
<meta name='twitter:title' content={title} />
<meta name='twitter:description' content={description} />
<meta name='twitter:image' content={ogImage} />
<script type='application/ld+json' set:html={JSON.stringify(websiteSchema)} />
<script type='application/ld+json' set:html={JSON.stringify(personSchema)} />
<link rel='preconnect' href='https://fonts.googleapis.com' />
<link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
<link href={`https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,400;0,500;0,600;0,700;0,800;1,500&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;0,8..60,700;1,8..60,400;1,8..60,500&family=IBM+Plex+Mono:wght@400;500${lang === 'zh' ? '&family=Noto+Serif+SC:wght@500;700' : ''}${extraFonts}&display=swap`} rel='stylesheet' />
<slot name="head" />
</head>
<body>

<div class='side-rail right'><span class='rail-text'>{t.railRight}</span></div>
<div class='side-rail left'><span class='rail-text'>{t.railLeft}</span></div>
<div class='shell'>

<div class='topbar'>
  <div class='container topbar-inner'>
    <span><span class='pulse'></span> <b>CityGenius</b> <span class='coral'>Blog</span></span>
    <span class='mid'>
      <span>Vol. 01 / Issue Nº 03</span>
      <span>·</span>
      <span>{lang === 'zh' ? 'Vibe Coding · 全栈 · AI' : 'Vibe Coding · Full-stack · AI'}</span>
    </span>
    <span class='right'>
      <span class='coord'>{issueDate}</span>
      <a class='topbar-link' href='https://github.com/37chengshan' target='_blank' rel='noreferrer noopener'>GitHub ↗</a>
    </span>
  </div>
</div>

<header class='nav' id='nav'>
  <div class='container nav-inner'>
    <a href={L('/#top')} class='brand'>
      <span class='brand-mark'>C</span>
      <span>CityGenius</span>
      <span class='brand-meta'><b>{t.brandMeta[0]}</b>{t.brandMeta[1]}</span>
    </a>
    <nav>
      <ul class='nav-links'>
        <li><a href={L('/#about')} data-key='1'><kbd>1</kbd>{t.nav.about}</a></li>
        <li><a href={L('/#projects')} data-key='2'><kbd>2</kbd>{t.nav.projects}</a></li>
        <li><a href={L('/article/')} data-key='3'><kbd>3</kbd>{t.nav.articles}</a></li>
        <li><a href={L('/news/')} data-key='4'><kbd>4</kbd>{t.nav.news}</a></li>
        <li><a href={L('/#contact')} data-key='5'><kbd>5</kbd>{t.nav.contact}</a></li>
      </ul>
    </nav>
    <div class='nav-side'>
      <button type='button' class='nav-icon pal-open' data-key='s' aria-label={ux.search} title={`${ux.search} · S / ⌘K`}><kbd>S</kbd><span class='nav-icon-label'>{ux.search}</span></button>
      <button type='button' class='nav-icon theme-toggle' data-key='d' aria-label={ux.theme} title={`${ux.theme} · D`}>
        <svg class='ti ti-sun' viewBox='0 0 12 12' shape-rendering='crispEdges' aria-hidden='true'><path d='M5 0h2v2H5zM5 10h2v2H5zM0 5h2v2H0zM10 5h2v2h-2zM1 1h2v2H1zM9 1h2v2H9zM1 9h2v2H1zM9 9h2v2H9zM4 3h4v1H4zM3 4h6v4H3zM4 8h4v1H4z'/></svg>
        <svg class='ti ti-moon' viewBox='0 0 12 12' shape-rendering='crispEdges' aria-hidden='true'><path d='M4 1h4v1H4zM3 2h2v1H3zM2 3h2v2H2zM1 5h3v2H1zM2 7h3v1H2zM2 8h4v1H2zM3 9h6v1H3zM4 10h4v1H4zM9 7h2v2H9zM10 6h1v1h-1z'/></svg>
      </button>
      <a class='nav-cta' href='https://github.com/37chengshan' target='_blank' rel='noreferrer noopener'>GitHub</a>
      <a class='lang-toggle' href={altHref} hreflang={other === 'zh' ? 'zh-CN' : 'en'} lang={other === 'zh' ? 'zh-CN' : 'en'} data-key='l' aria-label={t.langSwitch}>
        <span class:list={['lang-opt', { on: lang === 'zh' }]}>中</span><span class:list={['lang-opt', { on: lang === 'en' }]}>EN</span>
      </a>
    </div>
  </div>
</header>

<slot />

<footer>
  <div class='container'>
    <div class='foot-grid dim-group'>
      <div class='foot-brand'>
        <a href={L('/#top')} class='brand'><span class='brand-mark'>C</span><span>CityGenius</span></a>
        <p style='margin-top:18px;'>{t.footAbout}</p>
      </div>
      <div class='foot-col'><h5>{t.footNav}</h5><ul><li><a href={L('/#top')}>{t.footHome}</a></li><li><a href={L('/#about')}>{t.nav.about}</a></li><li><a href={L('/#projects')}>{t.nav.projects}</a></li><li><a href={L('/article/')}>{t.nav.articles}</a></li><li><a href={L('/news/')}>{t.nav.news}</a></li></ul></div>
      <div class='foot-col'><h5>{t.footProjects}</h5><ul><li><a href={L('/#projects')}>Scholar AI</a></li><li><a href={L('/#projects')}>{t.footMac}</a></li><li><a href={L('/#projects')}>{t.footAndroid}</a></li><li><a href={L('/article/vibe-coding-3-days/')}>{t.footLatest}</a></li></ul></div>
      <div class='foot-col'><h5>{t.footSocial}</h5><ul><li><a href='https://github.com/37chengshan' target='_blank' rel='noreferrer noopener'>GitHub</a></li><li><a href='https://x.com/' target='_blank' rel='noreferrer noopener'>Twitter / X</a></li><li><a href='mailto:hello@citygenius.dev'>Email</a></li></ul></div>
    </div>
    <div class='foot-bottom'><span>© 2026 CityGenius. Vibe Coding with intent.</span><span>{t.footLive}</span></div>
    <div class='foot-perch'><PixelCat scale={4} label={t.catLabel} /></div>
    <div class='foot-mega'><div class='word' data-reveal='rise-lg'>City<em>Genius</em>.</div></div>
  </div>
</footer>

</div>

<div class='pal-overlay' id='pal' hidden>
  <div class='pal' role='dialog' aria-modal='true' aria-label={ux.search}>
    <div class='pal-in'>
      <span class='pal-spark' aria-hidden='true'>✻</span>
      <input class='pal-input' type='text' placeholder={ux.palPh} autocomplete='off' spellcheck='false' aria-controls='pal-list' />
      <kbd class='pal-esc'>esc</kbd>
    </div>
    <ul class='pal-list' id='pal-list' role='listbox'></ul>
    <div class='pal-foot'>{ux.palHint.map(([k, v]) => <span><kbd>{k}</kbd>{v}</span>)}</div>
  </div>
</div>
<div class='toast' id='toast' role='status' aria-live='polite'></div>
<script type='application/json' id='pal-data' set:html={JSON.stringify(palData)}></script>

<script>
  (function () {
    var elements = document.querySelectorAll('[data-reveal]:not([data-revealed])');
    if (!elements.length) return;
    function revealAllPending() {
      var pending = document.querySelectorAll('[data-reveal]:not([data-revealed])');
      for (var k = 0; k < pending.length; k++) pending[k].dataset.revealed = 'true';
    }
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      revealAllPending();
      return;
    }
    var observer = new IntersectionObserver(function (entries) {
      for (var i = 0; i < entries.length; i++) {
        if (!entries[i].isIntersecting) continue;
        // Tall blocks can never reach the ratio threshold; reveal them once any part shows.
        var tall = entries[i].boundingClientRect.height > window.innerHeight * 0.6;
        if (!tall && entries[i].intersectionRatio < 0.12) continue;
        entries[i].target.dataset.revealed = 'true';
        observer.unobserve(entries[i].target);
      }
    }, { threshold: [0, 0.12], rootMargin: '0px 0px -8% 0px' });
    for (var j = 0; j < elements.length; j++) observer.observe(elements[j]);
    window.addEventListener('load', function () {
      window.setTimeout(revealAllPending, 1600);
    }, { once: true });
  })();
</script>

<script>
  (function () {
    var nav = document.getElementById('nav');
    if (!nav) return;
    var COMPACT_AT = 24;
    var lastY = window.scrollY || 0;
    function onScroll() {
      var y = window.scrollY || 0;
      if (y > COMPACT_AT) nav.classList.add('is-compact');
      else nav.classList.remove('is-compact');
      lastY = y;
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>

<script>
  (function () {
    var root = document.documentElement;
    var data = JSON.parse((document.getElementById('pal-data') || {}).textContent || '{}');
    var S = data.str || {};
    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    var cat = function (detail) { window.dispatchEvent(new CustomEvent('pxcat', { detail: detail })); };

    /* ---------- toast ---------- */
    var toastEl = document.getElementById('toast');
    var toastT;
    function toast(msg) {
      if (!toastEl) return;
      toastEl.textContent = msg;
      toastEl.classList.add('show');
      clearTimeout(toastT);
      toastT = setTimeout(function () { toastEl.classList.remove('show'); }, 1800);
    }
    window.cgToast = toast;

    /* ---------- theme ---------- */
    function setScheme(next, announce) {
      root.classList.add('theme-switching');
      root.dataset.scheme = next;
      try { localStorage.setItem('cg-scheme', next); } catch (e) {}
      setTimeout(function () { root.classList.remove('theme-switching'); }, 480);
      if (announce) {
        toast(next === 'dark' ? S.toDark : S.toLight);
        cat(next === 'dark' ? { face: 'sleepy', prop: 'zzz1', ms: 1800 } : { face: 'happy', prop: 'sparkle', ms: 1400, hop: true });
      }
    }
    function toggleScheme() { setScheme(root.dataset.scheme === 'dark' ? 'light' : 'dark', true); }
    document.querySelectorAll('.theme-toggle').forEach(function (b) { b.addEventListener('click', toggleScheme); });
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (e) {
      try { if (localStorage.getItem('cg-scheme')) return; } catch (err) {}
      setScheme(e.matches ? 'dark' : 'light', false);
    });

    /* ---------- copy helper ---------- */
    function copyText(text, msg) {
      var done = function () { toast(msg || S.copied); cat({ face: 'wink', prop: 'heart', ms: 1300, hop: true }); };
      if (navigator.clipboard) navigator.clipboard.writeText(text).then(done, done); else done();
    }
    window.cgCopy = copyText;

    /* ---------- command palette ---------- */
    var pal = document.getElementById('pal');
    var input = pal && pal.querySelector('.pal-input');
    var list = pal && pal.querySelector('.pal-list');
    var spark = pal && pal.querySelector('.pal-spark');
    var items = [], active = 0, lastFocus = null;
    var SPARK = ['✻', '✶', '✳', '✢', '·', '✢', '✳', '✶'], sparkI = 0, sparkT;
    function esc(s) { return String(s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
    function render(q) {
      q = q.trim().toLowerCase();
      var hit = function (x) { return !q || (x.t + ' ' + (x.k || '') + ' ' + (x.c || '')).toLowerCase().indexOf(q) !== -1; };
      var groups = [['posts', (data.posts || []).filter(hit).slice(0, q ? 8 : 5)], ['go', (data.go || []).filter(hit)], ['do', (data.do || []).filter(hit)]];
      var html = '';
      items = [];
      groups.forEach(function (g) {
        if (!g[1].length) return;
        html += '<li class="pal-group" role="presentation">' + esc(S[g[0]]) + '</li>';
        g[1].forEach(function (x) {
          var i = items.length;
          items.push(x);
          html += '<li class="pal-item" role="option" id="pal-o' + i + '" data-i="' + i + '"><span class="pal-t">' + esc(x.t) + '</span>' + (x.d ? '<span class="pal-m">' + esc(x.d) + '</span>' : '<span class="pal-m">↵</span>') + '</li>';
        });
      });
      if (!items.length) html = '<li class="pal-empty">' + esc(S.empty) + '</li>';
      list.innerHTML = html;
      move(0);
    }
    function move(i) {
      if (!items.length) return;
      active = (i + items.length) % items.length;
      list.querySelectorAll('.pal-item').forEach(function (el) { el.classList.toggle('on', Number(el.dataset.i) === active); el.setAttribute('aria-selected', Number(el.dataset.i) === active ? 'true' : 'false'); });
      var on = list.querySelector('.pal-item.on');
      if (on) { on.scrollIntoView({ block: 'nearest' }); input.setAttribute('aria-activedescendant', on.id); }
    }
    function run(x) {
      if (!x) return;
      closePal();
      if (x.h) { location.href = x.h; return; }
      if (x.a === 'theme') toggleScheme();
      if (x.a === 'copy') copyText(location.href, S.copied);
      if (x.a === 'top') window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    }
    function openPal() {
      if (!pal || !pal.hidden) return;
      lastFocus = document.activeElement;
      pal.hidden = false;
      render(input.value = '');
      requestAnimationFrame(function () { pal.classList.add('in'); input.focus(); });
      document.body.style.overflow = 'hidden';
    }
    function closePal() {
      if (!pal || pal.hidden) return;
      pal.classList.remove('in');
      document.body.style.overflow = '';
      setTimeout(function () { pal.hidden = true; }, reduce ? 0 : 200);
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    }
    if (pal) {
      document.querySelectorAll('.pal-open').forEach(function (b) { b.addEventListener('click', openPal); });
      pal.addEventListener('mousedown', function (e) { if (e.target === pal) closePal(); });
      list.addEventListener('mousemove', function (e) { var li = e.target.closest('.pal-item'); if (li && Number(li.dataset.i) !== active) move(Number(li.dataset.i)); });
      list.addEventListener('click', function (e) { var li = e.target.closest('.pal-item'); if (li) run(items[Number(li.dataset.i)]); });
      input.addEventListener('input', function () {
        render(input.value);
        if (reduce) return;
        clearTimeout(sparkT);
        spark.classList.add('spin');
        sparkI = (sparkI + 1) % SPARK.length;
        spark.textContent = SPARK[sparkI];
        sparkT = setTimeout(function () { spark.classList.remove('spin'); spark.textContent = '✻'; }, 420);
      });
      input.addEventListener('keydown', function (e) {
        if (e.isComposing) return;
        if (e.key === 'ArrowDown') { e.preventDefault(); move(active + 1); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); move(active - 1); }
        else if (e.key === 'Enter') { e.preventDefault(); run(items[active]); }
        else if (e.key === 'Escape') { e.preventDefault(); closePal(); }
        else if (e.key === 'Tab') { e.preventDefault(); move(active + (e.shiftKey ? -1 : 1)); }
      });
    }

    /* ---------- keys ---------- */
    var typing = function (el) { if (!el) return false; var tag = el.tagName; return tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || el.isContentEditable; };
    var KONAMI = ['arrowup', 'arrowup', 'arrowdown', 'arrowdown', 'arrowleft', 'arrowright', 'arrowleft', 'arrowright', 'b', 'a'];
    var kPos = 0, word = '';
    document.addEventListener('keydown', function (e) {
      if (e.isComposing) return;
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); pal && pal.hidden ? openPal() : closePal(); return; }
      if (e.defaultPrevented || e.metaKey || e.ctrlKey || e.altKey) return;
      if (typing(document.activeElement)) {
        if (e.key === 'Escape' && document.activeElement !== input) document.activeElement.blur();
        return;
      }
      var key = e.key.toLowerCase();
      kPos = key === KONAMI[kPos] ? kPos + 1 : (key === KONAMI[0] ? 1 : 0);
      if (kPos === KONAMI.length) { kPos = 0; party(); return; }
      word = (word + key).slice(-4);
      if (word === 'meow') { word = ''; toast(S.meow); cat({ face: 'love', prop: 'heart', ms: 1600, hop: true }); return; }
      if (key === '/') {
        var search = document.querySelector('[data-search]');
        e.preventDefault();
        if (search) search.focus(); else openPal();
        return;
      }
      var link = document.querySelector('[data-key="' + key + '"]');
      if (!link) return;
      e.preventDefault();
      link.classList.add('key-flash');
      setTimeout(function () { link.classList.remove('key-flash'); }, 400);
      link.click();
    });

    /* ---------- easter eggs ---------- */
    function party() {
      toast(S.konami);
      cat({ face: 'cheer', prop: 'sparkle', ms: 2600, hop: true });
      if (reduce) return;
      var box = document.createElement('div');
      box.className = 'confetti';
      for (var i = 0; i < 36; i++) {
        var p = document.createElement('i');
        p.style.setProperty('--x', (Math.random() * 100).toFixed(1) + 'vw');
        p.style.setProperty('--d', (Math.random() * 0.6).toFixed(2) + 's');
        p.style.setProperty('--r', (Math.random() * 720 - 360).toFixed(0) + 'deg');
        p.style.setProperty('--c', ['var(--coral)', '#f0b5c8', '#f7c744', '#629987', '#6a9bcc'][i % 5]);
        box.appendChild(p);
      }
      document.body.appendChild(box);
      setTimeout(function () { box.remove(); }, 2600);
    }
    var pokes = [], poked = false;
    document.addEventListener('click', function (e) {
      if (!e.target.closest || !e.target.closest('.pxcat')) return;
      var now = Date.now();
      pokes = pokes.filter(function (t) { return now - t < 2500; });
      pokes.push(now);
