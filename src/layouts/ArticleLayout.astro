---
import BaseLayout from './BaseLayout.astro';
import { assetUrl } from '../lib/url';
import PixelCat from '../components/PixelCat.astro';
import { ui, localePath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  slug: string;
  title: string;
  description: string;
  tag: string;
  date: string;
  readTime: string;
  authorMeta: string;
  image: string;
  imageAlt: string;
  sideNote: string;
  caption: string;
  tags: string[];
  tagFilters: Record<string, string>;
  related: { date: string; title: string; desc: string; tag: string; slug: string; }[];
}

const { lang, slug, title, description, tag, date, readTime, authorMeta, image, imageAlt, sideNote, caption, tags, tagFilters, related } = Astro.props;
const plainTitle = title.replace(/<[^>]+>/g, '');
const t = ui[lang];
const L = (p: string) => localePath(lang, p);
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const fmt = (d: string) => {
  const m = /^(\d{4})\.(\d{2})\.(\d{2})$/.exec(d);
  return !m || lang === 'zh' ? d : `${MONTHS[Number(m[2]) - 1]} ${m[3]}, ${m[1]}`;
};
const pageUrl = new URL(L(`/article/${slug}/`), Astro.site ?? 'https://37chengshan.github.io').href;
const shareX = `https://x.com/intent/post?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(plainTitle)}`;
---

<BaseLayout
  title={`${plainTitle} — CityGenius Blog`}
  description={description}
  extraFonts="&family=Noto+Serif+SC:wght@400;500;600;700"
  image={image}
  imageAlt={imageAlt}
  type="article"
  lang={lang}
>
  <Fragment slot="head">
    <style>
      /* ===== ARTICLE HEADER — Anthropic-style centered ===== */
      .article-header {
        padding: 8px 0 4px;
        border-bottom: none;
      }
      .article-header .header-shell {
        max-width: 920px;
        padding: 0 24px 0;
        text-align: center;
      }
      .article-header .header-grid {
        display: block;
      }
      .article-header .header-media { min-width: 0; margin: 18px auto 0; max-width: 720px; }
      .article-header .header-copy { min-width: 0; padding-top: 0; }
      .article-header .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: var(--sans);
        font-size: 13px;
        color: var(--ink-faint);
        text-decoration: none;
        margin-bottom: 10px;
        transition: color 0.18s ease;
      }
      .article-header .back-link:hover { color: var(--coral); }
      .article-header .back-link::before { content: '←'; }
      .article-meta-top {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        font-family: var(--sans);
        font-size: 12px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink-faint);
        margin-bottom: 18px;
      }
      .article-meta-top .tag { color: var(--ink); font-weight: 600; letter-spacing: 0.08em; text-transform: none; font-size: 13px; }
      .article-header h1 {
        font-family: var(--serif);
        font-size: clamp(32px, 4vw, 46px);
        font-weight: 600;
        letter-spacing: -0.02em;
        line-height: 1.22;
        margin: 0 auto 18px;
        max-width: 16ch;
        text-align: center;
        text-wrap: balance;
      }
      .article-header h1 em { font-family: var(--serif); font-style: italic; font-weight: 500; }
      .article-header h1 .dot { color: var(--coral); }
      .article-header .lead {
        font-family: var(--body);
        font-size: 17px;
        line-height: 1.65;
        color: var(--ink-soft);
        max-width: 42ch;
        margin: 0 auto 28px;
        text-align: center;
      }
      .article-header .about-art {
        position: relative;
        width: 100%;
        max-width: none;
        aspect-ratio: 16 / 10;
        padding-right: 0;
        padding-bottom: 0;
      }
      .article-header .about-art img {
        display: block;
        width: 100%;
        height: 100%;
        max-height: none;
        object-fit: cover;
        object-position: center center;
        border-radius: 16px;
      }
      .article-header .about-side-note {
        position: absolute;
        right: 14px;
        top: 14px;
        text-align: right;
        font-family: var(--sans);
        font-size: 10.5px;
        line-height: 1.45;
        color: rgba(var(--ink-rgb), 0.55);
        letter-spacing: 0.04em;
        max-width: 18ch;
      }
      .article-header .about-side-note b { display: none; }
      .article-header .about-caption {
        margin-top: 10px;
        text-align: center;
        font-family: var(--sans);
        font-size: 12px;
        color: var(--ink-faint);
        letter-spacing: 0.04em;
      }

      /* ===== BODY + FAR-LEFT FLOATING TOC ===== */
      .article-shell {
        display: grid;
        grid-template-columns: 200px minmax(0, 1fr);
        gap: 0;
        justify-content: stretch;
        align-items: start;
        padding: 0 32px 0;
        max-width: 1200px;
        margin: 0 auto;
      }
      .article-toc {
        position: sticky;
        top: 76px;
        padding: 8px 28px 0 0;
        font-family: var(--mono);
        max-height: calc(100vh - 96px);
        overflow-y: auto;
        scrollbar-width: none;
      }
      .article-toc::-webkit-scrollbar { display: none; }
      .article-body {
        max-width: 680px;
        margin: 0 auto;
        width: 100%;
      }
      .rail-title {
        font-family: var(--sans);
        font-size: 15px;
        font-weight: 600;
        line-height: 1.35;
        letter-spacing: -0.01em;
        color: var(--ink);
        margin-bottom: 26px;
        opacity: 0;
        translate: 0 6px;
        transition: opacity 0.4s ease, translate 0.4s cubic-bezier(0.22, 1, 0.36, 1);
      }
      .article-toc.is-past-header .rail-title { opacity: 1; translate: 0 0; }
      .rail-title :global(em) { font-family: var(--serif); font-style: italic; font-weight: 500; }
      .article-toc .toc-label {
        font-size: 11px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink-faint);
        margin: 0 0 12px;
      }
      .tree {
        list-style: none;
        margin: 0 0 30px;
        padding: 0;
        display: grid;
        gap: 7px;
      }
      .tree :global(li) {
        display: flex;
        gap: 8px;
        font-size: 12.5px;
        line-height: 1.45;
      }
      .tree :global(li)::before {
        content: '└';
        color: var(--ink-faint);
        flex: none;
      }
      .tree :global(a),
      .tree .copy-link {
        color: var(--ink-mute);
        text-decoration: none;
        background: none;
        border: 0;
        padding: 0;
        font: inherit;
        cursor: pointer;
        text-align: left;
        transition: color 0.18s ease;
      }
      .tree :global(a:hover),
      .tree .copy-link:hover { color: var(--coral); }
      .tree :global(a.is-active) { color: var(--ink); font-weight: 600; }
      .progress-block { margin: 6px 0 30px; position: relative; }
      .rail-cat {
        height: 42px;
        line-height: 0;
        will-change: transform;
      }
      .dither {
        position: relative;
        height: 10px;
        background: repeating-conic-gradient(rgba(var(--ink-rgb), 0.22) 0 25%, transparent 0 50%) 0 0 / 4px 4px;
      }
      .dither-fill {
        position: absolute;
        inset: 0;
        background: repeating-conic-gradient(var(--ink) 0 25%, rgba(var(--ink-rgb), 0.55) 0 50%) 0 0 / 4px 4px;
        clip-path: inset(0 calc(100% - var(--p, 0) * 100%) 0 0);
      }
      .progress-meta {
        display: flex;
        justify-content: space-between;
        margin-top: 8px;
        font-size: 11px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--ink-faint);
      }
      .mobile-progress { display: none; }
      @media (max-width: 1100px) {
        .article-shell { grid-template-columns: minmax(0, 1fr); padding: 0 20px; max-width: 720px; }
        .article-toc { display: none; }
        .article-body { max-width: none; margin: 0; }
        .mobile-progress {
          display: block;
          position: fixed;
          left: 0;
          right: 0;
          top: 0;
          height: 3px;
          z-index: 60;
          pointer-events: none;
        }
        .mobile-progress span {
          display: block;
          height: 100%;
          background: var(--coral);
          transform-origin: left;
          transform: scaleX(var(--p, 0));
        }
      }
      @media (max-width: 760px) {
        .article-shell { padding: 0 16px; }
      }
      .meta-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 24px;
        max-width: 640px;
        margin: 6px auto 8px;
        text-align: left;
      }
      .meta-grid dt {
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink-faint);
        margin-bottom: 8px;
      }
      .meta-grid dd {
        display: flex;
        flex-direction: column;
        gap: 2px;
        font-family: var(--sans);
        font-size: 14px;
        font-weight: 600;
        color: var(--ink);
      }
      .meta-grid dd::before {
        content: '└';
        font-family: var(--mono);
        font-weight: 400;
        color: var(--ink-faint);
        position: absolute;
        translate: -16px 0;
      }
      .meta-grid dd { position: relative; padding-left: 16px; }
      .meta-grid dd span {
        font-weight: 400;
        font-size: 12.5px;
        color: var(--ink-mute);
        line-height: 1.45;
      }
      @media (max-width: 560px) {
        .meta-grid { grid-template-columns: 1fr 1fr; gap: 18px; }
        .meta-grid div:first-child { grid-column: 1 / -1; }
      }
      /* ===== ARTICLE FOOTER ===== */
      .article-footer { padding: 48px 0; border-top: 1px solid var(--line); }
      .article-tags { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 32px; }
      .article-tags .tag-pill {
        font-family: var(--sans);
        font-size: 12px;
        padding: 6px 14px;
        border: 1px solid var(--line);
        border-radius: 999px;
        color: var(--ink-mute);
        text-decoration: none;
        transition: all 0.18s ease;
      }
      .article-tags .tag-pill:hover { background: var(--coral); border-color: var(--coral); color: #fff; }
      .share-row {
        display: flex;
        align-items: center;
        gap: 16px;
        font-family: var(--sans);
        font-size: 13px;
        color: var(--ink-faint);
      }
      .share-row a {
        color: var(--ink);
        text-decoration: none;
        border-bottom: 1px solid var(--line);
        transition: color 0.18s ease, border-color 0.18s ease;
      }
      .share-row a:hover { color: var(--coral); border-bottom-color: var(--coral); }

      /* ===== RELATED ===== */
      .related { padding: 40px 0 56px; border-top: 1px solid var(--line); }
      .related h3 {
        font-family: var(--sans);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--coral);
        margin-bottom: 36px;
        display: inline-flex;
        align-items: center;
        gap: 12px;
      }
      .related h3::before { content: ''; width: 18px; height: 1px; background: var(--coral); display: inline-block; }
      .related-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
      .related-card {
        display: block;
        text-decoration: none;
        color: inherit;
        padding: 28px 24px;
        background: var(--bone);
        border-radius: 16px;
        box-shadow: var(--shadow), inset 0 0 0 1px rgba(var(--ink-rgb), 0.06);
        transition: transform 0.2s ease;
      }
      .related-card:hover { transform: translateY(-3px); }
      .related-card .rc-date { font-family: var(--mono); font-size: 11px; color: var(--ink-faint); margin-bottom: 10px; }
      .related-card h4 {
        font-family: var(--sans);
        font-size: 19px;
        font-weight: 700;
        letter-spacing: -0.012em;
        line-height: 1.2;
        margin-bottom: 10px;
      }
      .related-card p { font-family: var(--body); font-size: 13.5px; color: var(--ink-mute); line-height: 1.55; }
      .related-card .rc-tag {
        display: inline-block;
        font-family: var(--sans);
        font-size: 10px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--coral);
        margin-top: 12px;
        font-weight: 600;
      }

      /* article-specific overrides */
      .nav-cta::after { content: ''; }
      .foot-grid { grid-template-columns: 2fr 1fr 1fr 1fr; }

      /* responsive */
      @media (max-width: 880px) {
        .article-header .header-shell { padding: 0 20px 8px; }
        .article-header h1 { max-width: none; }
        .related-grid { grid-template-columns: 1fr; }
        .article-header .about-art { aspect-ratio: auto; }
        .article-header .about-art img { height: auto; object-fit: contain; }
      }
      @media (max-width: 760px) {
        .article-shell { padding: 0 16px; }
      }
      @media (max-width: 560px) {
        .article-header .header-shell { padding: 0 16px 8px; }
        .article-header { padding: 24px 0 12px; }
      }
    </style>
  </Fragment>

  {/* ARTICLE HEADER — centered Anthropic layout */}
  <header class='article-header'>
    <div class='container header-shell'>
      <div class='header-grid'>
        <div class='header-copy'>
          <a class='back-link' href={L('/article/')} data-reveal>{t.article.back}</a>
          <div class='article-meta-top' data-reveal>
            <span class='tag'>{tag}</span>
          </div>
          <h1 data-reveal><Fragment set:html={title} /><span class='dot'>.</span></h1>
          <dl class='meta-grid' data-reveal>
            <div><dt>{t.article.author}</dt><dd>CityGenius<span>{authorMeta}</span></dd></div>
            <div><dt>{t.article.published}</dt><dd>{fmt(date)}</dd></div>
            <div><dt>{t.article.readTime}</dt><dd>{readTime}</dd></div>
          </dl>
        </div>
        <div class='header-media'>
          <div class='about-art' data-reveal='scale'>
            <img src={assetUrl(image)} alt={imageAlt} width={Astro.props.imageWidth} height={Astro.props.imageHeight} decoding='async' fetchpriority='high' />
            <div class='about-side-note'><Fragment set:html={sideNote} /></div>
          </div>
          <div class='about-caption'><Fragment set:html={caption} /></div>
        </div>
      </div>
    </div>
  </header>

  {/* BODY + FLOATING TOC */}
  <div class='article-shell'>
    <aside class='article-toc' aria-label={t.article.tree}>
      <div class='rail-title'><Fragment set:html={title} /></div>
      <div class='toc-label'>{t.article.tree}</div>
      <ul class='tree' data-toc-list></ul>
      <div class='progress-block'>
        <div class='rail-cat' data-rail-cat><PixelCat scale={2} label={t.catLabel} /></div>
        <div class='dither' aria-hidden='true'><span class='dither-fill' data-progress-fill></span></div>
        <div class='progress-meta'><span data-progress-pct>0%</span><span>{readTime}</span></div>
      </div>
      <div class='toc-label'>{t.article.share}</div>
      <ul class='tree'>
        <li><a href={shareX} target='_blank' rel='noreferrer noopener'>X.com</a></li>
        <li><button type='button' class='copy-link' data-copy-link data-copied={t.article.copied}>{t.article.copyLink}</button></li>
        <li><a href='#top' data-to-top>{t.article.top}</a></li>
      </ul>
    </aside>
    <div class='mobile-progress' aria-hidden='true'><span data-progress-fill></span></div>
    <article class='article-body' style='padding-top:24px;'>
      <div class='prose'>
        <slot />
      </div>
    </article>
  </div>

  {/* ARTICLE FOOTER */}
  <div class='article-footer'>
    <div class='container narrow'>
      <div class='article-tags' data-reveal>
        {tags.map((tg) => (
          <a class='tag-pill' href={L(`/article/?category=${tagFilters[tg] || 'all'}`)}>{tg}</a>
        ))}
      </div>
      <div class='share-row' data-reveal>
        <span>{t.article.share}</span>
        <a href={shareX} target='_blank' rel='noreferrer noopener'>X.com</a>
        <a href='https://github.com/37chengshan' target='_blank' rel='noreferrer noopener'>GitHub</a>
        <a href={L('/article/')}>{t.article.back}</a>
      </div>
    </div>
  </div>

  {/* RELATED */}
  <section class='related'>
    <div class='container narrow'>
      <h3 data-reveal>{t.article.related}</h3>
      <div class='related-grid'>
        {related.map((r) => (
          <a class='related-card' href={L(`/article/${r.slug}/`)} data-reveal>
            <span class='rc-date'>{fmt(r.date)}</span>
            <h4>{r.title}</h4>
            <p>{r.desc}</p>
            <span class='rc-tag'>{r.tag}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <script>
    (function () {
      var prose = document.querySelector('.article-body .prose');
      if (!prose) return;
      var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      var lang = document.documentElement.lang === 'en';
      /* code boxes */
      prose.querySelectorAll('pre').forEach(function (pre) {
        if (pre.parentElement.classList.contains('code-box')) return;
        var box = document.createElement('div');
        box.className = 'code-box';
        var head = document.createElement('div');
        head.className = 'code-head';
        var l = pre.getAttribute('data-language') || '';
        head.innerHTML = '<span>CODE</span>' + (l && l !== 'plaintext' ? '<span class="lang">' + l + '</span>' : '') + '<button type="button" class="code-copy"><span class="idle">' + (lang ? 'Copy' : '复制') + '</span><span class="done" aria-hidden="true">' + (lang ? 'Copied' : '已复制') + '</span></button>';
        pre.parentNode.insertBefore(box, pre);
        box.appendChild(head);
        box.appendChild(pre);
        var btn = head.querySelector('.code-copy');
        btn.addEventListener('click', function () {
          var ok = function () { btn.setAttribute('data-copied', ''); setTimeout(function () { btn.removeAttribute('data-copied'); }, 1600); window.dispatchEvent(new CustomEvent('pxcat', { detail: { face: 'happy', prop: 'note', ms: 1200 } })); };
          if (navigator.clipboard) navigator.clipboard.writeText(pre.innerText).then(ok, ok); else ok();
        });
      });
      /* heading anchors */
      prose.querySelectorAll('h2, h3').forEach(function (h, i) {
        if (!h.id) h.id = (h.tagName === 'H2' ? 'section-' : 'sub-') + (i + 1);
        var a = document.createElement('a');
        a.className = 'h-anchor';
        a.href = '#' + h.id;
        a.textContent = '#';
        a.setAttribute('aria-label', lang ? 'Copy link to this section' : '复制本节链接');
        a.addEventListener('click', function (e) {
          e.preventDefault();
          history.replaceState(null, '', '#' + h.id);
          h.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
          if (window.cgCopy) window.cgCopy(location.href);
        });
        h.prepend(a);
      });
      /* image zoom */
      var open = null;
      function close() {
        if (!open) return;
        var o = open; open = null;
        o.veil.classList.remove('in');
        o.img.style.transform = 'none';
        setTimeout(function () { o.veil.remove(); o.img.remove(); o.src.style.visibility = ''; }, reduce ? 0 : 420);
      }
      prose.addEventListener('click', function (e) {
        var src = e.target.closest && e.target.closest('figure.illu img');
        if (!src || open) return;
        var r = src.getBoundingClientRect();
        var vw = innerWidth, vh = innerHeight, pad = 32;
        var nw = src.naturalWidth || r.width, nh = src.naturalHeight || r.height;
        var s = Math.min((vw - pad * 2) / r.width, (vh - pad * 2) / r.height, Math.max(1, nw / r.width));
        var veil = document.createElement('div');
        veil.className = 'zoom-veil';
        var img = src.cloneNode();
        img.className = 'zoom-img';
        img.removeAttribute('loading');
        img.style.cssText = 'left:' + r.left + 'px;top:' + r.top + 'px;width:' + r.width + 'px;height:' + r.height + 'px';
        document.body.append(veil, img);
        src.style.visibility = 'hidden';
        open = { veil: veil, img: img, src: src };
        var tx = (vw - r.width * s) / 2 - r.left, ty = (vh - r.height * s) / 2 - r.top;
        requestAnimationFrame(function () { veil.classList.add('in'); img.style.transform = 'translate(' + tx + 'px,' + ty + 'px) scale(' + s + ')'; });
        veil.addEventListener('click', close);
        img.addEventListener('click', close);
      });
      addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
      addEventListener('scroll', close, { passive: true });
    })();
  </script>
  <script>
    (function () {
      var list = document.querySelector('[data-toc-list]');
      var prose = document.querySelector('.article-body .prose');
      var rail = document.querySelector('.article-toc');
      if (!list || !prose) return;
      var heads = Array.prototype.slice.call(prose.querySelectorAll('h2'));
      heads.forEach(function (h, i) {
        if (!h.id) h.id = 'section-' + (i + 1);
        var li = document.createElement('li');
        var a = document.createElement('a');
        a.href = '#' + h.id;
        a.textContent = h.textContent.replace(/\.$/, '');
        li.appendChild(a);
        list.appendChild(li);
      });
      var links = Array.prototype.slice.call(list.querySelectorAll('a'));
      var fills = Array.prototype.slice.call(document.querySelectorAll('[data-progress-fill]'));
      var pct = document.querySelector('[data-progress-pct]');
      var catWrap = document.querySelector('[data-rail-cat]');
      var cat = catWrap && catWrap.querySelector('.pxcat');
      var header = document.querySelector('.article-header');
      var cheered = false;
      var ticking = false;

      function update() {
        ticking = false;
        var y = window.scrollY + 110;
        var active = -1;
        for (var i = 0; i < heads.length; i++) if (heads[i].offsetTop <= y) active = i;
        for (var j = 0; j < links.length; j++) links[j].classList.toggle('is-active', j === active);

        var start = prose.offsetTop;
        var end = start + prose.offsetHeight - window.innerHeight * 0.75;
        var p = Math.min(1, Math.max(0, (window.scrollY - start + window.innerHeight * 0.25) / Math.max(1, end - start)));
        for (var k = 0; k < fills.length; k++) fills[k].style.setProperty('--p', p.toFixed(4));
        if (pct) pct.textContent = Math.round(p * 100) + '%';
        if (catWrap && cat) {
          var room = catWrap.clientWidth - cat.offsetWidth;
          catWrap.style.transform = 'translateX(' + Math.round(room * p / 2) * 2 + 'px)';
        }
        if (rail && header) rail.classList.toggle('is-past-header', window.scrollY > header.offsetTop + header.offsetHeight - 80);
        if (p >= 0.995 && !cheered) {
          cheered = true;
          window.dispatchEvent(new CustomEvent('pxcat', { detail: { face: 'cheer', prop: 'sparkle', ms: 2200, hop: true } }));
        } else if (p < 0.9) {
          cheered = false;
        }
      }
      function onScroll() {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(update);
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      update();

      var copy = document.querySelector('[data-copy-link]');
      if (copy) {
        var label = copy.textContent;
        copy.addEventListener('click', function () {
          var done = function () {
            copy.textContent = copy.dataset.copied;
            window.dispatchEvent(new CustomEvent('pxcat', { detail: { face: 'wink', prop: 'heart', ms: 1400 } }));
            window.setTimeout(function () { copy.textContent = label; }, 1600);
          };
          if (navigator.clipboard) navigator.clipboard.writeText(window.location.href.split('#')[0]).then(done, done);
          else done();
        });
      }
      var toTop = document.querySelector('[data-to-top]');
      if (toTop) toTop.addEventListener('click', function (e) {
        e.preventDefault();
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
