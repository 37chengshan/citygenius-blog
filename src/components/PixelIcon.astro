---
// 12x12 pixel icons for article rows, drawn on the same grid language as the cat.
interface Props { name: string; size?: number }
const { name, size = 24 } = Astro.props;
const ICONS: Record<string, string[]> = {
  ai: [
    '..#..#..#...',
    '.#########..',
    '##.......##.',
    '.#.#####.#..',
    '##.#...#.##.',
    '.#.#.#.#.#..',
    '##.#...#.##.',
    '.#.#####.#..',
    '##.......##.',
    '.#########..',
    '..#..#..#...',
    '............',
  ],
  macos: [
    '............',
    '.##########.',
    '.#........#.',
    '.#.##.....#.',
    '.#.#......#.',
    '.#........#.',
    '.##########.',
    '############',
    '#..........#',
    '############',
    '............',
    '............',
  ],
  android: [
    '..#......#..',
    '...#....#...',
    '..########..',
    '.##########.',
    '.##.####.##.',
    '.##########.',
    '............',
    '.##########.',
    '.##########.',
    '.##########.',
    '.##########.',
    '..##....##..',
  ],
  'full-stack': [
    '............',
    '..########..',
    '..#......#..',
    '..########..',
    '............',
    '.##########.',
    '.#........#.',
    '.##########.',
    '............',
    '############',
    '#..........#',
    '############',
  ],
  doc: [
    '.#######....',
    '.#.....##...',
    '.#.....#.#..',
    '.#.....####.',
    '.#........#.',
    '.#.####...#.',
    '.#........#.',
    '.#.######.#.',
    '.#........#.',
    '.#.#####..#.',
    '.#........#.',
    '.##########.',
  ],
};
const grid = ICONS[name] ?? ICONS.doc;
let d = '';
grid.forEach((row, y) => {
  let x = 0;
  while (x < row.length) {
    if (row[x] !== '#') { x++; continue; }
    let e = x;
    while (row[e + 1] === '#') e++;
    d += `M${x} ${y}h${e - x + 1}v1h-${e - x + 1}z`;
    x = e + 1;
  }
});
---
<svg class='px-icon' width={size} height={size} viewBox='0 0 12 12' aria-hidden='true' shape-rendering='crispEdges'><path d={d} fill='currentColor' /></svg>
