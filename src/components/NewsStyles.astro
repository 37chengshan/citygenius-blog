---
// 新闻页共享样式（入口页 + 各板块页）。
// 卡片由 JS 动态生成，必须用 is:global，否则 Astro 作用域选择器匹配不上。
---
<style is:global>
  main.container > section.news-page { padding: 34px 0 64px; }

  .crumb a { color: inherit; text-decoration: none; }
  .crumb a:hover { color: var(--coral); }

  /* 入口页：板块卡片 */
  .hub-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin-top: 30px;
  }
  .hub-card {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--bone);
    padding: 26px 24px;
    text-decoration: none;
    color: var(--ink);
    cursor: pointer;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .hub-card:hover { transform: translateY(-2px); box-shadow: var(--shadow); }
  .hub-ix {
    font-family: var(--serif);
    font-style: italic;
    font-size: 34px;
    color: var(--coral);
    line-height: 1;
    flex: 0 0 auto;
  }
  .hub-main { flex: 1; min-width: 0; }
  .hub-title {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-family: var(--sans);
    font-weight: 800;
    font-size: 22px;
    letter-spacing: -0.01em;
  }
  .hub-title .count {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-faint);
    letter-spacing: 0.08em;
    font-weight: 400;
    white-space: nowrap;
  }
  .hub-title a { color: inherit; text-decoration: none; }
  .hub-title a:hover { color: var(--coral); }
  .hub-tops a { color: inherit; text-decoration: none; }
  .hub-tops a:hover { color: var(--coral); text-decoration: underline; }
  .hub-arrow { text-decoration: none; }
  .hub-desc { margin-top: 6px; font-size: 13px; color: var(--ink-mute); }
  .hub-tops { margin: 14px 0 0; padding: 0; list-style: none; display: grid; gap: 8px; }
  .hub-tops li {
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--ink-soft);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .hub-tops li::before { content: "·  "; color: var(--coral); }
  .hub-arrow {
    font-size: 20px;
    color: var(--coral);
    margin-top: 2px;
    flex: 0 0 auto;
    transition: transform 0.18s ease;
  }
  .hub-card:hover .hub-arrow { transform: translateX(4px); }

  /* 板块页 */
  .cat-head { display: flex; align-items: baseline; gap: 18px; margin: 30px 0 4px; }
  .cat-head h1 {
    font-family: var(--sans);
    font-weight: 800;
    font-size: clamp(28px, 4vw, 44px);
    letter-spacing: -0.02em;
  }
  .cat-desc { color: var(--ink-mute); font-size: 14px; }
  .cat-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-top: 48px;
    border-top: 1px solid var(--line);
    padding-top: 22px;
  }
  .cat-nav a {
    font-family: var(--sans);
    font-size: 14px;
    color: var(--ink);
    text-decoration: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 10px 20px;
    background: var(--bone);
    transition: background 0.18s ease, color 0.18s ease, border-color 0.18s ease;
    white-space: nowrap;
  }
  .cat-nav a:hover { background: var(--ink); color: var(--paper); border-color: var(--ink); }

  .module-ix {
    font-family: var(--serif);
    font-style: italic;
    font-size: 30px;
    color: var(--coral);
    line-height: 1;
  }

  /* ---- 新闻卡片：板块页三栏（构建期和浏览器端用同一份 HTML，见 news-shared.js） ---- */
  .news-grid3 {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px 20px;
    margin-top: 24px;
  }
  .nc {
    display: flex;
    flex-direction: column;
    background: var(--bone);
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    color: var(--ink);
    text-decoration: none;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .nc:hover { transform: translateY(-2px); box-shadow: var(--shadow); }
  .nc-photo {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--paper-dark);
  }
  .nc-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .nc:hover .nc-photo img { transform: scale(1.03); }
  .nc-body { flex: 1; padding: 16px 18px 20px; }
  .nc-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    margin-bottom: 8px;
    font-family: var(--sans);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }
  .nc-src { color: var(--coral); font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; }
  .nc-title {
    font-family: var(--sans);
    font-size: 17px;
    font-weight: 700;
    line-height: 1.45;
    margin: 0 0 8px;
    text-wrap: pretty;
  }
  .nc-sum {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--ink-soft);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .nc-take {
    margin: 12px 0 0;
    padding-top: 10px;
    border-top: 1px dashed var(--line);
    font-size: 13px;
    line-height: 1.6;
    color: var(--ink-mute);
  }
  .nc-take b { color: var(--coral); font-weight: 700; font-size: 12px; letter-spacing: 0.08em; margin-right: 8px; }
  /* 没有原图：顶部一道强调色，标题略大，撑住卡片 */
  .nc-text { box-shadow: inset 0 3px 0 var(--coral); }
  .nc-text:hover { box-shadow: inset 0 3px 0 var(--coral), var(--shadow); }
  .nc-text .nc-body { padding-top: 22px; }
  .nc-text .nc-title { font-size: 19px; }

  /* 头条：左图右文 */
  .nc-feat {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    margin: 22px 0 0;
    border-radius: 18px;
  }
  .nc-feat .nc-photo { aspect-ratio: auto; min-height: 340px; }
  .nc-feat .nc-body { display: flex; flex-direction: column; justify-content: center; padding: 30px 32px; }
  .nc-feat .nc-title { font-size: clamp(22px, 2.4vw, 28px); font-weight: 800; line-height: 1.32; margin-bottom: 12px; }
  .nc-feat .nc-sum { font-size: 15px; line-height: 1.75; -webkit-line-clamp: 6; }
  .nc-feat.nc-text { display: flex; }
  .nc-feat.nc-text .nc-body { padding: 34px 36px; }
  .nc-feat.nc-text .nc-title { font-size: clamp(24px, 3vw, 34px); }
  .news-empty {
    padding: 40px 20px;
    text-align: center;
    color: var(--ink-mute);
    font-size: 15px;
    border: 1px dashed var(--line);
    border-radius: 14px;
  }
  .news-updated { margin: 14px 4px 0; text-align: right; }

  /* ---- 板块页：日期时间 ---- */
  .date-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 10px 0 12px;
    font-size: 12px;
    color: var(--ink-mute);
  }
  .date-badge {
    display: inline-block;
    background: rgba(217, 119, 87, 0.14);
    border: 1px solid rgba(217, 119, 87, 0.45);
    color: var(--coral);
    font-weight: 700;
    padding: 2px 10px;
    border-radius: 999px;
    font-size: 12px;
    white-space: nowrap;
  }
  .date-line .week { color: var(--ink-soft); white-space: nowrap; }
  .date-line .rel { color: var(--coral); font-weight: 700; white-space: nowrap; }
  .date-line .src {
    margin-left: auto;
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  /* ---- 板块页：hero ---- */
  .cat-hero {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 20px;
    margin: 26px 0 6px;
    padding: 26px 32px 28px;
    background: linear-gradient(115deg, rgba(217, 119, 87, 0.10), rgba(217, 119, 87, 0.02) 60%, transparent 80%);
  }
  .cat-hero-copy { position: relative; z-index: 2; }
  .cat-hero .module-ix { font-size: 30px; }
  .cat-hero h1 {
    font-family: var(--sans);
    font-weight: 800;
    font-size: clamp(30px, 4vw, 44px);
    letter-spacing: -0.02em;
    margin: 6px 0 6px;
  }
  .cat-hero .cat-desc { font-size: 15px; }
  /* ---- 入口页：板块卡小图（该板块头条原图） ---- */
  .hub-photo {
    flex: 0 0 118px;
    width: 118px;
    aspect-ratio: 1;
    border-radius: 12px;
    overflow: hidden;
    align-self: center;
    background: var(--paper-dark);
  }
  .hub-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* ---- 文章页 ---- */
  .art { max-width: 760px; margin: 26px auto 0; }
  .art-kicker {
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--coral);
    font-weight: 700;
    margin-bottom: 12px;
  }
  .art-title {
    font-family: var(--sans);
    font-weight: 800;
    font-size: clamp(28px, 4.4vw, 44px);
    letter-spacing: -0.02em;
    line-height: 1.35;
    margin-bottom: 8px;
  }
  .art-en-title {
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-mute);
    margin-bottom: 6px;
  }
  .art .date-line { margin: 14px 0 4px; }
  .art-photo { margin: 26px 0 8px; }
  .art-photo img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 18px;
    background: var(--paper-dark);
  }
  .art-photo figcaption { margin-top: 8px; font-size: 12px; color: var(--ink-faint); }
  .art-body { margin-top: 22px; }
  .art .take {
    margin: 4px 0 24px;
    padding: 14px 18px;
    border-left: 3px solid var(--coral);
    background: var(--bone);
    border-radius: 0 12px 12px 0;
    font-size: 15px;
    line-height: 1.75;
    color: var(--ink-soft);
  }
  .art .take b { display: block; color: var(--coral); font-size: 12px; letter-spacing: 0.14em; margin-bottom: 4px; }
  .art-body p {
    font-size: 16.5px;
    line-height: 1.85;
    color: var(--ink-soft);
    margin-bottom: 1.2em;
  }
  .art-take {
    margin: 26px 0;
    padding: 16px 18px;
    border-left: 3px solid var(--coral);
    background: var(--bone);
    border-radius: 0 12px 12px 0;
    font-size: 14.5px;
    line-height: 1.75;
    color: var(--ink-soft);
  }
  .art-take b {
    display: block;
    color: var(--coral);
    font-size: 12px;
    letter-spacing: 0.14em;
    margin-bottom: 6px;
  }
  .art-en {
    margin: 20px 0;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 14px 18px;
    background: var(--paper);
    font-size: 13.5px;
    color: var(--ink-mute);
  }
  .art-en summary { cursor: pointer; font-weight: 700; color: var(--ink-soft); }
  .art-en .en-sum { margin-top: 10px; line-height: 1.7; }
  .art-origin {
    margin: 30px 0 0;
    padding: 20px 22px;
    border: 1px dashed var(--line);
    border-radius: 14px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }
  .art-origin-meta {
    display: grid;
    gap: 6px;
    font-size: 13px;
    color: var(--ink-mute);
  }
  .read-origin {
    display: inline-block;
    background: var(--coral);
    color: #fff;
    font-weight: 700;
    font-size: 14px;
    padding: 12px 26px;
    border-radius: 999px;
    text-decoration: none;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
    white-space: nowrap;
  }
  .read-origin:hover { transform: translateY(-2px); box-shadow: var(--shadow); }
  .art-nav { margin-top: 34px; }
  .art-nav span { flex: 1; }

  @media (max-width: 1080px) {
    .news-grid3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 880px) {
    .hub-grid { grid-template-columns: 1fr; }
    .cat-nav a { padding: 8px 14px; font-size: 13px; }
    .news-grid3 { grid-template-columns: 1fr; }
    .nc-feat { grid-template-columns: 1fr; }
    .nc-feat .nc-photo { min-height: 0; aspect-ratio: 16 / 9; }
    .nc-feat .nc-body { padding: 20px 20px 24px; }
    .hub-photo { display: none; }
    .art { margin-top: 18px; }
    .art-origin { flex-direction: column; align-items: stretch; }
    .read-origin { text-align: center; }
  }
</style>
