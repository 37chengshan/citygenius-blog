---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const zhArticles = await getCollection('blog');
  const enArticles = await getCollection('en');
  const enById = new Map(enArticles.map((entry) => [entry.id, entry]));
  return zhArticles.map((article) => ({
    params: { slug: article.id },
    props: { article, enArticle: enById.get(article.id) ?? null },
  }));
}

const { article, enArticle } = Astro.props;

// en layer falls back to zh content when a translation is missing
const enEntry = enArticle ?? article;
const { Content: ZhContent } = await render(article);
const { Content: EnContent } = await render(enEntry);

const zh = article.data;
const en = enEntry.data;
---

<ArticleLayout
  zhTitle={zh.title}
  enTitle={en.title}
  zhDesc={zh.description}
  enDesc={en.description}
  tag={en.tag}
  zhTag={zh.tag}
  date={zh.date}
  readTime={en.readTime}
  zhReadTime={zh.readTime}
  authorMeta={en.authorMeta}
  zhAuthorMeta={zh.authorMeta}
  image={zh.image}
  imageWidth={zh.imageWidth}
  imageHeight={zh.imageHeight}
  imageAlt={en.imageAlt}
  sideNote={en.sideNote}
  caption={en.caption}
  tags={en.tags}
  zhTags={zh.tags}
  tagFilters={en.tagFilters}
  zhTagFilters={zh.tagFilters}
  related={en.related}
  zhRelated={zh.related}
>
  <Fragment slot="zhBody"><ZhContent /></Fragment>
  <Fragment slot="enBody"><EnContent /></Fragment>
</ArticleLayout>
