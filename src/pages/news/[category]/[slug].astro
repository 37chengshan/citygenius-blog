---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NewsStyles from '../../../components/NewsStyles.astro';
import { withBase } from '../../../lib/url';
import { NEWS_CATS } from '../../../lib/news-cats.js';
import { readFileSync } from 'node:fs';
import { esc, slugFor, dateParts, fullTime, illusFor, catLabel } from '../../../lib/news-shared.js';
import { takeHtml, readOriginHtml, artNavHtml } from '../../../lib/news-render.js';

export function getStaticPaths() {
  const snap = JSON.parse(readFileSync(new URL('../../../../public/news.json', import.meta.url), 'utf-8'));
  const paths = [];
  const seen = new Set();
  for (const c of snap.categories || []) {
    const meta = NEWS_CATS.find((x) => x.id === c.id);
    if (!meta) continue;
    const items = c.items || [];
    items.forEach((it, i) => {
      let slug = slugFor(it.link || it.title);
      let n = 2;
      while (seen.has(c.id + '/' + slug)) slug = slugFor(it.link || it.title) + '-' + n++;
      seen.add(c.id + '/' + slug);
      const sib = (j) =>
        j >= 0 && j < items.length
          ? { slug: slugFor(items[j].link || items[j].title), en: items[j].title || '', zh: items[j].zh_title || items[j].title || '' }
          : null;
      paths.push({
        params: { category: c.id, slug },
        props: { item: it, meta, prev: sib(i - 1), next: sib(i + 1) },
      });
    });
  }
  return paths;
}

const { category, slug } = Astro.params;
const { item, meta, prev, next } = Astro.props;

const hubHref = withBase('/news/');
const catHref = withBase('/news/' + category + '/');
const prevHref = prev ? withBase('/news/' + category + '/' + prev.slug + '/') : null;
const nextHref = next ? withBase('/news/' + category + '/' + next.slug + '/') : null;

const catL = catLabel(category) || {};
const catEn = catL.en || meta.label;

const pEn = dateParts(item.published, 'en');
const pZh = dateParts(item.published, 'zh') || dateParts(item.published);
const enTitle = item.en_title || item.title || '';
const zhTitle = item.zh_title || item.title;
const enParas = (item.en_summary || item.summary || '').split('\n').filter((s) => s.trim());
const zhParas = (item.zh_summary || '').split('\n').filter((s) => s.trim());

const newsSchema = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: enTitle,
  inLanguage: 'en',
  datePublished: item.published || undefined,
  author: { '@type': 'Person', name: 'CityGenius', url: 'https://github.com/37chengshan' },
  isBasedOn: item.link,
  about: catEn,
};
---

<BaseLayout title={enTitle + ' — ' + catEn + ' — CityGenius Blog'} description={(item.en_summary || item.summary || '').slice(0, 150)}>
  <Fragment slot="head">
    <NewsStyles />
    <script type="application/ld+json" set:html={JSON.stringify(newsSchema)} />
  </Fragment>

  <main class="container" id="top">
    <section class="tight news-page">
      <div class="sec-rule">
        <span class="crumb">
          <a href={hubHref}><span class="roman">News</span></a> ·
          <a href={catHref}><span class="lang-en">{catEn}</span><span class="lang-zh">{meta.label}</span></a> ·
          <span class="lang-en">Article</span><span class="lang-zh">正文</span>
        </span>
        <span class="meta-grp"><span>{item.source}</span></span>
      </div>

      <article class="art">
        <div class="art-kicker"><span class="lang-en">{catEn}</span><span class="lang-zh">{meta.label}</span></div>
        <h1 class="art-title"><span class="lang-en">{enTitle}</span><span class="lang-zh">{zhTitle}</span></h1>
        <div class="date-line">
          <div class="lang-en">
            {pEn && <span class="date-badge">{pEn.date}</span>}
            {pEn && <span class="week">{pEn.week} · {pEn.hm}</span>}
            <span class="src">{item.source}</span>
          </div>
          <div class="lang-zh">
            {pZh && <span class="date-badge">{pZh.date}</span>}
            {pZh && <span class="week">{pZh.week} · {pZh.hm}</span>}
            <span class="src">{item.source}</span>
          </div>
        </div>

        <div class="illus art-illus" set:html={illusFor(item.link || item.title, meta.pal, true)} />

        <div class="art-body">
          <div class="lang-en">
            {enParas.map((para) => (
              <p>{para}</p>
            ))}
          </div>
          <div class="lang-zh">
            {zhParas.map((para) => (
              <p>{para}</p>
            ))}
          </div>
        </div>

        <Fragment set:html={takeHtml(item.zh_take)} />

        <div class="art-origin">
          <div class="art-origin-meta">
            <span><span class="lang-en">Source: </span><span class="lang-zh">来源：</span>{item.source}</span>
            {item.published && (
              <span title={fullTime(item.published, 'en')}>
                <span class="lang-en">Published: </span><span class="lang-zh">发布时间：</span>
                <span class="lang-en">{pEn ? `${pEn.date} ${pEn.week} ${pEn.hm}` : ''}</span><span class="lang-zh">{pZh ? `${pZh.date} ${pZh.week} ${pZh.hm}` : ''}</span>
              </span>
            )}
          </div>
          <Fragment set:html={readOriginHtml(item.link)} />
        </div>

        <Fragment
          set:html={artNavHtml({
            prevHref,
            prevEn: prev?.en,
            prevZh: prev?.zh,
            catHref,
            catEn,
            catZh: meta.label,
            nextHref,
            nextEn: next?.en,
            nextZh: next?.zh,
          })}
        />
      </article>
    </section>
  </main>
</BaseLayout>
