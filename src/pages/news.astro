---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsStyles from '../components/NewsStyles.astro';
import { withBase } from '../lib/url';
import { NEWS_CATS } from '../lib/news-cats.js';
import { readFileSync } from 'node:fs';
import { staticHub } from '../lib/news-render.js';

const newsUrl = withBase('/news.json');
const cats = NEWS_CATS.map((c) => ({ ...c, href: withBase('/news/' + c.id + '/') }));

// 构建期快照：入口页六张板块卡片直接写进 HTML（爬虫可见），JS 加载后刷新为最新。
let snapData = null;
try {
  snapData = JSON.parse(readFileSync(new URL('../../public/news.json', import.meta.url), 'utf-8'));
} catch (e) {
  snapData = null;
}
const hubHtml = staticHub(cats, snapData);
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: '新闻速览 — CityGenius Blog',
  description: 'AI 科技、国际新闻、财经、体育、娱乐、无畏契约六个板块，每日更新两次，突发新闻即时跟进。',
  inLanguage: 'zh-CN',
};
---

<BaseLayout
  title="新闻速览 — CityGenius Blog"
  description="AI 科技、国际新闻、财经、体育、娱乐、无畏契约六个板块，每日更新两次，突发新闻即时跟进。"
>
  <Fragment slot="head">
    <NewsStyles />
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  </Fragment>

  <main class="container" id="top">
    <section class="tight news-page">
      <div class="sec-rule">
        <span><span class="roman">News</span> · 速览</span>
        <span class="meta-grp"><span>每日两更</span><span class="dot-mark">●</span><span>突发即时跟进</span><span class="dot-mark">●</span><span>六个板块</span></span>
      </div>
      <div class="hub-grid" id="news-hub" set:html={hubHtml} />
      <p class="meta news-updated" id="news-updated">正在加载…</p>
    </section>
  </main>

  <Fragment slot="scripts">
    <script define:vars={{ newsUrl, cats }}>
      (function () {
        var hubEl = document.getElementById('news-hub');
        var updatedEl = document.getElementById('news-updated');
        function esc(s) {
          return String(s == null ? '' : s)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;')
            .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }
        function pad(n) { return (n < 10 ? '0' : '') + n; }
        var WEEK = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'];
        function relTime(iso) {
          var t = new Date(iso).getTime();
          if (isNaN(t)) return '';
          var diff = Date.now() - t;
          if (diff < 0) diff = 0;
          var m = Math.floor(diff / 60000);
          if (m < 1) return '刚刚';
          if (m < 60) return m + ' 分钟前';
          var h = Math.floor(m / 60);
          if (h < 24) return h + ' 小时前';
          var days = Math.floor(h / 24);
          if (days === 1) return '昨天';
          if (days < 30) return days + ' 天前';
          return Math.floor(days / 30) + ' 个月前';
        }
        function fmtUpdated(iso) {
          var d = new Date(iso);
          if (isNaN(d.getTime())) return iso;
          var min = d.getMinutes();
          return '数据更新于 ' + (d.getMonth() + 1) + '月' + d.getDate() + '日'
            + ' ' + WEEK[d.getDay()]
            + ' ' + d.getHours() + ':' + (min < 10 ? '0' : '') + min
            + ' · ' + relTime(iso);
        }
        function hubCard(ix, meta, c, href) {
          var items = (c && c.items) || [];
          var tops = '';
          for (var t = 0; t < Math.min(3, items.length); t++) {
            tops += '<li>' + esc(items[t].zh_title || items[t].title) + '</li>';
          }
          return '<a class="hub-card" href="' + href + '">'
            + '<div class="hub-ix">' + pad(ix + 1) + '</div>'
            + '<div class="hub-main">'
            + '<div class="hub-title">' + esc(meta.label) + '<span class="count">' + items.length + ' 条</span></div>'
            + '<div class="hub-desc">' + esc(meta.desc) + '</div>'
            + (tops ? '<ul class="hub-tops">' + tops + '</ul>' : '')
            + '</div>'
            + '<div class="hub-arrow" aria-hidden="true">→</div>'
            + '</a>';
        }
        function render(data) {
          var categories = (data && data.categories) || [];
          if (updatedEl && data && data.generated_at) {
            updatedEl.textContent = fmtUpdated(data.generated_at);
          }
          var html = '';
          for (var i = 0; i < cats.length; i++) {
            var meta = cats[i];
            var c = null;
            for (var k = 0; k < categories.length; k++) {
              if (categories[k].id === meta.id) {
                c = categories[k];
                break;
              }
            }
            html += hubCard(i, meta, c, meta.href);
          }
          hubEl.innerHTML = html;
        }
        function load() {
          fetch(newsUrl + '?t=' + Date.now(), { cache: 'no-store' })
            .then(function (r) { return r.json(); })
            .then(render)
            .catch(function () {
              if (!hubEl.innerHTML.trim()) {
                hubEl.innerHTML = '<div class="news-empty">新闻加载失败，稍后再试。</div>';
              }
            });
        }
        load();
        setInterval(load, 10 * 60 * 1000);
      })();
    </script>
  </Fragment>
</BaseLayout>
